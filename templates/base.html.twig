<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Task Manager{% endblock %} · Symfony Demo</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body class="bg-light">
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">&#10003; TaskManager</a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="{{ path('app_home') }}">Dashboard</a>
            <a class="nav-link" href="{{ path('app_task_index') }}">Tasks</a>
            <a class="nav-link" href="{{ path('app_category_index') }}">Categories</a>
        </div>
        <div class="d-flex align-items-center">
            {% if app.user %}
                <span class="navbar-text me-3">{{ app.user.name }} &lt;{{ app.user.email }}&gt;</span>
                <form method="post" action="{{ path('app_logout') }}">
                    <button class="btn btn-outline-light btn-sm" type="submit">Log out</button>
                </form>
            {% else %}
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Log in</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container pb-5">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="container text-muted small pb-4">
    Built with Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }} · Docker demo project
</footer>
</body>
</html>
