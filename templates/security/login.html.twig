{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3 text-center">Log in</h1>

                    {% if error %}
                        <div class="alert alert-danger py-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label" for="inputEmail">Email</label>
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                                   class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="inputPassword">Password</label>
                            <input type="password" name="password" id="inputPassword"
                                   class="form-control" autocomplete="current-password" required>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-primary w-100" type="submit">Sign in</button>
                    </form>
                </div>
                <div class="card-footer bg-white small text-muted">
                    Demo accounts (see README):
                    <div>admin@demo.local / password123</div>
                    <div>alex@demo.local / password123</div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
