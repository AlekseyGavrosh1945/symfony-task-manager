{% extends 'base.html.twig' %}

{% block title %}Tasks{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">Tasks <span class="text-muted fs-6">({{ total }})</span></h1>
        <a class="btn btn-primary" href="{{ path('app_task_new') }}">+ New task</a>
    </div>

    {# ---------- filters ---------- #}
    <form class="card border-0 shadow-sm mb-3" method="get" action="{{ path('app_task_index') }}">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted" for="q">Search</label>
                <input type="text" id="q" name="q" value="{{ q }}" class="form-control" placeholder="Title or description...">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All</option>
                    {% for s in enum('App\\Enum\\TaskStatus').cases() %}
                        <option value="{{ s.value }}" {{ status == s ? 'selected' }}>{{ s.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All</option>
                    {% for c in categories %}
                        <option value="{{ c.id }}" {{ categoryId == c.id ? 'selected' }}>{{ c.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-fill" type="submit">Filter</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_task_index') }}" title="Reset filters">✕</a>
            </div>
        </div>
    </form>

    {# ---------- list ---------- #}
    <div class="card border-0 shadow-sm">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Category</th>
                <th>Due date</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for task in tasks %}
                <tr>
                    <td>
                        <a href="{{ path('app_task_show', {id: task.id}) }}"
                           class="{{ task.status.value == 'done' ? 'task-title-done' }}">{{ task.title }}</a>
                    </td>
                    <td><span class="badge {{ task.status.badgeClass }}">{{ task.status.label }}</span></td>
                    <td><span class="badge {{ task.priority.badgeClass }}">{{ task.priority.label }}</span></td>
                    <td>
                        {% if task.category %}
                            <span class="badge" style="background-color: {{ task.category.color }}">{{ task.category.name }}</span>
                        {% else %}<span class="text-muted">—</span>{% endif %}
                    </td>
                    <td class="{{ task.isOverdue ? 'due-overdue' }}">
                        {{ task.dueDate ? task.dueDate|date('Y-m-d') : '—' }}
                        {% if task.isOverdue %}(overdue){% endif %}
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            {% if task.status.value != 'done' %}
                                <form method="post" action="{{ path('app_task_complete', {id: task.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ task.id) }}">
                                    <button class="btn btn-sm btn-outline-success" title="Mark as done">&#10003;</button>
                                </form>
                            {% endif %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_task_edit', {id: task.id}) }}">Edit</a>
                            <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}"
                                  onsubmit="return confirm('Delete this task?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Delete">&#128465;</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Nothing found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# ---------- pagination ---------- #}
    {% if totalPages > 1 %}
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                {% set filterParams = {q: q, status: status ? status.value : null, category: categoryId} %}
                <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_task_index', filterParams|merge({page: currentPage - 1})|filter(v => v is not null)) }}">&laquo;</a>
                </li>
                {% for p in 1..totalPages %}
                    <li class="page-item {{ p == currentPage ? 'active' }}">
                        <a class="page-link" href="{{ path('app_task_index', filterParams|merge({page: p})|filter(v => v is not null)) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_task_index', filterParams|merge({page: currentPage + 1})|filter(v => v is not null)) }}">&raquo;</a>
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}
